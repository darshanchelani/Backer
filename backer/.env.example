# ---------------------------------------------------------------
# Backer - environment template
# Copy to .env and fill in. Everything except DATABASE_URL is
# optional: the app runs with graceful fallbacks when a key is
# missing (see README "Going live" section).
# ---------------------------------------------------------------

# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://backer:backer@localhost:5434/backer?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secrets - generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""
IP_HASH_SALT=""
CRON_SECRET=""

# Clerk - https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Resend - https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Domain that receives investor replies, e.g. reply.getbacker.com (MX -> Postmark)
INBOUND_DOMAIN=""

# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs from your Stripe products (Pro $49/mo, Scale $199/mo)
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
NEXT_PUBLIC_STRIPE_PRICE_SCALE=""

# Optional integrations
POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed for source-map uploads during build (sentry.io -> Project -> Client Keys)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SLACK_WEBHOOK_URL=""
